#! /usr/bin/env python3
"""Control OLED display brightness by applying ICC color profiles.

icc-brightness BRIGHTNESS MAX-BRIGHTNESS - set brightness manually
    for exmplae setting 70% brightness:
    icc-brightness 70 100
icc-brightness apply - apply brightness from system setting
icc-brightness watch - continuously update to system setting
icc-brightness clean - remove all profiles generated by us
"""

import sys
import os
import subprocess
import time
import fcntl
import signal
import threading
import logging
from ctypes import cdll, c_void_p, c_uint32, c_char_p, c_double, c_int, Array
from types import FrameType
from typing import cast

TEMP_FOLDER = '/tmp'

CWD = os.path.dirname(__file__)
ICC_BRIGHTNESS_GEN = os.path.join(CWD, 'icc-brightness-gen')

LOCK = threading.Lock()

LCMS2 = cdll.LoadLibrary('liblcms2.so.2')


cmsSigProfileDescriptionTag = 0x64657363
cmsSigVcgtTag = 0x76636774


LCMS2.cmsCreate_sRGBProfile.argtypes = []
LCMS2.cmsCreate_sRGBProfile.restype = c_void_p

def cmsCreate_sRGBProfile() -> c_void_p:
    return LCMS2.cmsCreate_sRGBProfile()


LCMS2.cmsMLUalloc.argtypes = [c_void_p, c_uint32]
LCMS2.cmsMLUalloc.restype = c_void_p

def cmsMLUalloc(context_id: c_void_p | None, n_items: int) -> c_void_p:
    return LCMS2.cmsMLUalloc(context_id, c_uint32(n_items))


LCMS2.cmsMLUfree.argtypes = [c_void_p]
LCMS2.cmsMLUfree.restype = None

def cmsMLUfree(mlu: c_void_p) -> None:
    LCMS2.cmsMLUfree(mlu)


LCMS2.cmsMLUsetASCII.argtypes = [c_void_p, c_char_p, c_char_p, c_char_p]
LCMS2.cmsMLUsetASCII.restype = c_int

def cmsMLUsetASCII(mlu: c_void_p, language_code: str, country_code: str, ascii_string: str) -> bool:
    r = LCMS2.cmsMLUsetASCII(
        mlu,
        c_char_p(language_code.encode("ascii")),
        c_char_p(country_code.encode("ascii")),
        c_char_p(ascii_string.encode("ascii"))
    )
    return r == 1


LCMS2.cmsWriteTag.argtypes = [c_void_p, c_int, c_void_p]
LCMS2.cmsWriteTag.restype = c_int

def cmsWriteTag(hProfile: c_void_p, sig: int, data: c_void_p | Array) ->bool:
    r =  LCMS2.cmsWriteTag(hProfile, c_int(sig), data)
    return r == 1


LCMS2.cmsCreateContext.argtypes = [c_void_p, c_void_p]
LCMS2.cmsCreateContext.restype = c_void_p

def cmsCreateContext(
        plugin: c_void_p | None, user_data: c_void_p | None) -> c_void_p:
    return LCMS2.cmsCreateContext(plugin, user_data)


LCMS2.cmsBuildParametricToneCurve.argtypes = [c_void_p, c_int, c_double * 3]
LCMS2.cmsBuildParametricToneCurve.restype = c_void_p

def cmsBuildParametricToneCurve(context_id: c_void_p, curve_type: int, params: tuple[float, float, float]) -> c_void_p:
    return LCMS2.cmsBuildParametricToneCurve(context_id, c_int(curve_type), (c_double * 3)(*params))


LCMS2.cmsFreeToneCurve.argtypes = [c_void_p]
LCMS2.cmsFreeToneCurve.restype = None

def cmsFreeToneCurve(ToneCurve: c_void_p) -> None:
    LCMS2.cmsFreeToneCurve(ToneCurve)


LCMS2.cmsSaveProfileToFile.argtypes = [c_void_p, c_char_p]
LCMS2.cmsSaveProfileToFile.restype = c_int

def cmsSaveProfileToFile(hProfile: c_void_p, filename: str) -> bool:
    r = LCMS2.cmsSaveProfileToFile(hProfile, c_char_p(filename.encode("ascii")))
    return r == 1


def create_srgb_profile(brightness: float) -> c_void_p:

    hsRGB = cmsCreate_sRGBProfile()

    mlu = cmsMLUalloc(None, 1)
    cmsMLUsetASCII(mlu, "en", "US", f"Brightness {brightness:.2f}")
    cmsWriteTag(hsRGB, cmsSigProfileDescriptionTag, mlu)
    cmsMLUfree(mlu);

    context_id = cmsCreateContext(None, None)
    curve = (1.0, brightness, 0.0)
    tone_curve = (c_void_p * 3)(
	    cmsBuildParametricToneCurve(context_id, 2, curve),
	    cmsBuildParametricToneCurve(context_id, 2, curve),
	    cmsBuildParametricToneCurve(context_id, 2, curve),
    )
    cmsWriteTag(hsRGB, cmsSigVcgtTag, tone_curve)
    cmsFreeToneCurve(cast(c_void_p, tone_curve[0]))
    cmsFreeToneCurve(cast(c_void_p, tone_curve[1]))
    cmsFreeToneCurve(cast(c_void_p, tone_curve[2]))

    return hsRGB;


def generate_profile(filename: str, brightness: int, max_brightness: int) -> None:
    ratio = brightness / max_brightness
    hs_rgb = create_srgb_profile(ratio)
    r = cmsSaveProfileToFile(hs_rgb, filename)
    if r != 1:
        raise Exception(f"Failed to save profile to file {filename}")


def get_backlight_path() -> str:
    """Detect the backlight path, trying intel_backlight and nvidia_0."""
    backlight_options = ['intel_backlight', 'nvidia_0']
    for backlight in backlight_options:
        backlight_path = os.path.join('/sys/class/backlight', backlight)
        brightness_path = os.path.join(backlight_path, 'brightness')
        if os.path.exists(brightness_path):
            return backlight_path
    raise FileNotFoundError(
        'No supported backlight found. Tried: ' + ', '.join(backlight_options)
    )


def clean() -> None:
    """Find all profile generated by us and remove them."""
    out = subprocess.check_output(['colormgr', 'get-profiles'], env={'LANG':'C'})

    object_path = None
    filename = None
    for line in out.decode('utf8').split('\n'):
        if line.startswith('Object Path:'):
            object_path = line.split(':')[1].lstrip()
            continue
        if line.startswith('Filename:'):
            filename = line.split(':')[1].lstrip()
            if filename.find('/brightness_') < 0:
                continue
            logging.info('Removing: %s', filename)
            if object_path is not None:
                subprocess.run(['colormgr', 'delete-profile', object_path],
                               check=True)
            subprocess.run(['rm', filename], check=True)


def get_object_path(out: bytes) -> str | None:
    object_path = None
    for line in out.decode('utf8').split('\n'):
        if line.startswith('Object Path:'):
            object_path = line.split(':')[1].lstrip()
            break
    return object_path


def find_profile(filename: str) -> str | None:
    try:
        out = subprocess.check_output(
                ['colormgr', 'find-profile-by-filename', filename], env={'LANG':'C'})
    except subprocess.CalledProcessError:
        return None
    return get_object_path(out)


def get_device_id() -> str:
    device_id = None
    out = subprocess.check_output(
        ['colormgr', 'get-devices-by-kind', 'display'], env={'LANG': 'C'}
    )
    for line in out.decode('utf8').split('\n'):
        if line.startswith('Object Path:'):
            device_id = line.split(':')[1].lstrip()
        elif line.startswith('Embedded:'):
            embedded = line.split(':')[1].lstrip()
            if embedded == "Yes":
                break
    if device_id is None:
        raise Exception("Failed to find object path.")
    return device_id


last_icc_filename = None

def icc_brightness(brightness: int , max_brightness: int) -> None:

    icc_filename = 'brightness_%d_%d.icc' % (brightness, max_brightness)
    logging.debug('Apply profile %s', icc_filename)
    object_path = find_profile(icc_filename)
    if object_path is None:
        icc_filepath = os.path.join(TEMP_FOLDER, icc_filename)
        generate_profile(icc_filepath, brightness, max_brightness)

        # Without timeout=1 import-profile randomly freezes for longer with the message:
        # ERROR: b'The profile was not added in time\n'
        try:
            subprocess.run(
                ['colormgr', 'import-profile', icc_filepath],
                env={'LANG':'C'},
                stdout=subprocess.PIPE,
                check=True,
                timeout=1,
            )
        except subprocess.TimeoutExpired as ex:
            logging.warning(str(ex))
            return
        object_path = find_profile(icc_filename)
        if object_path is None:
            raise Exception("Failed to find object path to add")
        try:
            subprocess.run(['colormgr', 'device-add-profile',
                            get_device_id(), object_path], check=True)
        except subprocess.CalledProcessError as ex:
            logging.warning('Failed to add profile: %s', ex.stdout)

    subprocess.run(['colormgr', 'device-make-profile-default',
                    get_device_id(), object_path], check=True)

    global last_icc_filename
    if last_icc_filename is not None and last_icc_filename != icc_filename:
        object_path = find_profile(last_icc_filename)
        if object_path is None:
            raise Exception("Failed to find object path to delete")
        subprocess.run(['colormgr', 'delete-profile', object_path], check=True)
    last_icc_filename = icc_filename


def icc_brightness_apply() -> None:
    backlight_path = get_backlight_path()
    brightness_path = os.path.join(backlight_path, 'brightness')
    max_brightness_path = os.path.join(backlight_path, 'max_brightness')
    with open(brightness_path) as infile:
        brightness = int(infile.readline())
    with open(max_brightness_path) as infile:
        max_brightness = int(infile.readline())
    icc_brightness(brightness, max_brightness)


def handler(signum: int, frame: FrameType | None) -> None:
    if LOCK.acquire(blocking=False):
        try:
            icc_brightness_apply()
        except subprocess.CalledProcessError as ex:
            logging.exception('Error during call to icc_brightness')
            logging.error(ex.stdout)
        except BaseException:
            logging.exception('Error during call to icc_brightness')
        finally:
            LOCK.release()


def main() -> None:
    logging.basicConfig(level=logging.INFO,
                        format='%(levelname)s: %(message)s')

    if len(sys.argv) == 2 and sys.argv[1] == 'clean':
        clean()

    elif len(sys.argv) == 2 and sys.argv[1] == 'apply':
        icc_brightness_apply()

    elif len(sys.argv) == 2 and sys.argv[1] == 'watch':
        try:
            icc_brightness_apply()
        except BaseException:
            logging.exception('device-make-profile-default')
        signal.signal(signal.SIGIO, handler)
        backlight_path = get_backlight_path()
        fd = os.open(backlight_path, os.O_RDONLY)
        fcntl.fcntl(fd, fcntl.F_SETSIG, 0)
        fcntl.fcntl(fd, fcntl.F_NOTIFY, fcntl.DN_MODIFY| fcntl.DN_MULTISHOT)

        while True:
            signal.pause()

    elif len(sys.argv) == 3:
        brightness = int(sys.argv[1])
        max_brightness = int(sys.argv[2])
        icc_brightness(brightness, max_brightness)

    else:
        print(__doc__)


if __name__ == '__main__':
    main()
